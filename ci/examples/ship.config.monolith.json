{
  "schemaVersion": "1.0",
  "shape": "monolith",
  "config": "backend",
  "forge": "github",
  "packageManager": "pnpm",
  "versioning": "changesets",
  "registry": { "provider": "ghcr", "visibility": "public" },
  "sharedPaths": [],
  "services": {
    "app": { "path": ".", "framework": "nest", "type": "api" }
  },
  "gates": {
    "structure": true,
    "lint": true,
    "typecheck": true,
    "unit": true,
    "integration": true,
    "coverageMin": { "lines": 75 },
    "e2e": "off",
    "package": false
  }
}
