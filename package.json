{
  "name": "index-ai",
  "version": "1.0.0-rc1",
  "description": "An open specification proposal that makes websites verifiably readable by AI agents — specification, validator guidance, and docs.",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "keywords": [
    "ai",
    "llm",
    "agents",
    "standard",
    "specification",
    "machine-web",
    "token-economics"
  ],
  "author": "Hard Machine Labs",
  "license": "MIT",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --strict docs/.vitepress/theme/lib/useValidatorState.ts vitest.config.ts playwright.config.ts",
    "lint": "node ci/lint.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsparticles/engine": "^4.3.2",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "animejs": "^4.5.0",
    "apexcharts": "^6.7.0",
    "changeset": "^0.2.6",
    "chart.js": "^4.5.1",
    "echarts": "^6.1.0",
    "geopattern": "^1.2.3",
    "granim": "^2.0.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "maplibre-gl": "^6.2.0",
    "p5": "^2.3.2",
    "paper": "^0.12.18",
    "pixi.js": "^8.19.0",
    "three": "^0.185.1",
    "tsparticles": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vanta": "^0.5.24",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  }
}
