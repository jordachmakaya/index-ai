{
  "name": "index-ai",
  "version": "1.0.0-rc2",
  "description": "An open specification proposal that makes websites verifiably readable by AI agents — specification, validator guidance, and docs.",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "keywords": [
    "ai",
    "llm",
    "agents",
    "standard",
    "specification",
    "machine-web",
    "token-economics"
  ],
  "author": "Hard Machine Labs",
  "license": "MIT",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node ci/refresh-dogfood.mjs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "node benchmark/run.mjs --sites-per-level 50 --seed 20260813 --status Published",
    "typecheck": "tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --strict docs/.vitepress/theme/lib/useValidatorState.ts examples/mcp-server/server.ts vitest.config.ts playwright.config.ts",
    "lint": "node ci/lint.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  }
}
